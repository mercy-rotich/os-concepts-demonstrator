
<UserControl
    xmlns:models="using:OS_Concepts_Demonstrator.Models"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:OS_Concepts_Demonstrator.ViewModels.Processes"
    x:Class="OS_Concepts_Demonstrator.Views.Processes.ProcessesView"
    x:DataType="vm:ProcessesViewModel">

    <Grid Margin="32"
          RowDefinitions="Auto,*"
          RowSpacing="24">

        <!-- PAGE HEADING -->
        <StackPanel Grid.Row="0" 
                    Spacing="6">
            <TextBlock
                Text="Process Management"
                FontSize="28"
                FontWeight="Bold"/>

            <TextBlock
                Text="Explore the processes currently running on your system."
                FontSize="14"
                Opacity="0.7"/>
        </StackPanel>

        <!-- MAIN CONTENT -->
        <Grid Grid.Row="1"
              ColumnDefinitions="2*,*"
              ColumnSpacing="20">

            <!-- LEFT: PROCESS LIST -->
            <Border
                Grid.Column="0"
                Background="#1B1B2B"
                CornerRadius="12"
                Padding="20">

                <Grid RowDefinitions="Auto,Auto,Auto,*"
                      RowSpacing="16">

                    <!-- SEARCH -->
                    <TextBox
                        Grid.Row="0"
                        PlaceholderText="Search by process name or PID..."
                        Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                        Padding="12"
                        FontSize="14"/>

                    <!-- SORTING -->
                    <Grid Grid.Row="1"
                          ColumnDefinitions="*,Auto"
                          ColumnSpacing="12">

                        <ComboBox
                            Grid.Column="0"
                            ItemsSource="{Binding SortOptions}"
                            SelectedItem="{Binding SortBy}"
                            HorizontalAlignment="Stretch"
                            PlaceholderText="Sort by"/>

                        <CheckBox
                            Grid.Column="1"
                            Content="Descending"
                            IsChecked="{Binding SortDescending}"
                            VerticalAlignment="Center"/>

                    </Grid>

                    <!-- PROCESS COUNT AND REFRESH -->
                    <Grid Grid.Row="2"
                          ColumnDefinitions="*,Auto">

                        <StackPanel Spacing="4">
                            <TextBlock
                                Text="Running Processes"
                                FontSize="20"
                                FontWeight="SemiBold"/>

                            <TextBlock
                                Text="{Binding TotalProcesses, StringFormat='Total processes: {0}'}"
                                FontSize="13"
                                Opacity="0.7"/>
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            Content="Refresh"
                            IsEnabled="{Binding !IsLoading}"
                            Padding="16,8"
                            VerticalAlignment="Center"
                            Click="OnRefreshClick"/>

                    </Grid>

                    <!-- PROCESS TABLE -->
                    <Grid Grid.Row="3"
                          RowDefinitions="Auto,Auto,*">

                        <Border
                            Grid.Row="0"
                            Background="#292940"
                            Padding="12">

                            <Grid ColumnDefinitions="65,*,95">

                                <TextBlock
                                    Text="PID"
                                    FontWeight="Bold"/>

                                <TextBlock
                                    Grid.Column="1"
                                    Text="Process Name"
                                    FontWeight="Bold"/>

                                <TextBlock
                                    Grid.Column="2"
                                    Text="Memory"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Right"/>

                            </Grid>
                        </Border>

                        <!-- STATUS MESSAGES -->
                        <StackPanel Grid.Row="1" Spacing="6" Margin="0,8,0,0">
                            <TextBlock
                                Text="Loading processes..."
                                IsVisible="{Binding IsLoading}"
                                Foreground="#38BDF8"/>

                            <TextBlock
                                Text="{Binding ErrorMessage}"
                                IsVisible="{Binding HasError}"
                                Foreground="#F87171"
                                TextWrapping="Wrap"/>

                            <TextBlock
                                Text="No processes match your search."
                                IsVisible="{Binding HasNoMatches}"
                                Opacity="0.7"/>
                        </StackPanel>

                        <ListBox
                            Grid.Row="2"
                            ItemsSource="{Binding Processes}"
                            SelectedItem="{Binding SelectedProcess, Mode=TwoWay}"
                            Background="Transparent"
                            BorderThickness="0">

                            <ListBox.ItemTemplate>
                                <DataTemplate
                                    x:DataType="models:ProcessInfoModel">

                                    <Border
                                        BorderBrush="#303044"
                                        BorderThickness="0,0,0,1"
                                        Padding="10,14">

                                        <Grid ColumnDefinitions="65,*,95">

                                            <TextBlock
                                                Text="{Binding ProcessId}"
                                                VerticalAlignment="Center"/>

                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding Name}"
                                                VerticalAlignment="Center"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip.Tip="{Binding Name}"/>

                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{Binding MemoryUsageMb, StringFormat='{}{0:F1}'}"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"/>

                                        </Grid>
                                    </Border>

                                </DataTemplate>
                            </ListBox.ItemTemplate>

                        </ListBox>

                    </Grid>

                </Grid>
            </Border>

            <!-- RIGHT: PROCESS DETAILS -->
            <Border
                Grid.Column="1"
                Background="#1B1B2B"
                CornerRadius="12"
                Padding="20">

                <!-- Scrolls when the details + actions are taller than the window,
                     so the confirmation boxes and messages are never cut off. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="20">

                    <TextBlock
                        Text="Process Details"
                        FontSize="22"
                        FontWeight="Bold"/>

                    <!-- EMPTY STATE -->
                    <TextBlock
                        Text="Select a process from the list to view its details."
                        TextWrapping="Wrap"
                        Opacity="0.7"
                        IsVisible="{Binding !HasSelection}"/>

                    <!-- SELECTED PROCESS -->
                    <StackPanel
                        Spacing="16"
                        IsVisible="{Binding HasSelection}">

                        <Border
                            Background="#292940"
                            CornerRadius="8"
                            Padding="14">

                            <StackPanel Spacing="6">
                                <TextBlock
                                    Text="Process Name"
                                    Opacity="0.7"
                                    FontSize="13"/>

                                <TextBlock
                                    Text="{Binding DetailName}"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    TextWrapping="Wrap"/>
                            </StackPanel>

                        </Border>

                        <StackPanel Spacing="5">
                            <TextBlock
                                Text="Process ID"
                                Opacity="0.7"
                                FontSize="13"/>

                            <TextBlock
                                Text="{Binding DetailProcessId}"
                                FontSize="16"
                                FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock
                                Text="Memory Usage"
                                Opacity="0.7"
                                FontSize="13"/>

                            <TextBlock
                                Text="{Binding DetailMemory}"
                                FontSize="16"
                                FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock
                                Text="Status"
                                Opacity="0.7"
                                FontSize="13"/>

                            <TextBlock
                                Text="{Binding DetailStatus}"
                                FontSize="16"
                                FontWeight="SemiBold"/>

                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock
                                Text="Priority (nice)"
                                Opacity="0.7"
                                FontSize="13"/>

                            <TextBlock
                                Text="{Binding DetailPriority}"
                                FontSize="16"
                                FontWeight="SemiBold"/>

                        </StackPanel>

                        <StackPanel Spacing="5">
                            <TextBlock
                                Text="Start Time"
                                Opacity="0.7"
                                FontSize="13"/>

                            <TextBlock
                                Text="{Binding DetailStartTime}"
                                FontSize="16"
                                FontWeight="SemiBold"/>

                        </StackPanel>

                        <Border
                            Background="#292940"
                            CornerRadius="8"
                            Padding="14">

                            <StackPanel Spacing="12">
                                <TextBlock
                                    Text="Process Actions"
                                    FontSize="16"
                                    FontWeight="SemiBold"/>

                                <TextBlock
                                    Text="Protected system processes cannot be terminated or reprioritized from this panel."
                                    FontSize="12"
                                    Opacity="0.7"
                                    IsVisible="{Binding IsSelectedProcessProtected}"
                                    TextWrapping="Wrap"/>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="10" RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="0"
                                        Content="Suspend"
                                        IsEnabled="{Binding CanSuspend}"
                                        Command="{Binding SuspendCommand}"/>

                                    <Button
                                        Grid.Row="0"
                                        Grid.Column="1"
                                        Content="Resume"
                                        IsEnabled="{Binding CanResume}"
                                        Command="{Binding ResumeCommand}"/>

                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="0"
                                        Content="Terminate"
                                        IsEnabled="{Binding CanTerminate}"
                                        Command="{Binding AskTerminateCommand}"/>

                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Content="Force Kill"
                                        IsEnabled="{Binding CanForceKill}"
                                        Command="{Binding AskForceKillCommand}"/>

                                    <Button
                                        Grid.Row="2"
                                        Grid.Column="1"
                                        Content="Refresh"
                                        Command="{Binding RefreshSelectedCommand}"
                                        IsEnabled="{Binding !IsLoading}"/>
                                </Grid>

                                <!-- Confirmations and the result message sit directly under the
                                     buttons so they appear where the user just clicked. -->
                                <Border
                                    Background="#3A2F1B"
                                    BorderBrush="#FBBF24"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    IsVisible="{Binding ShowTerminateConfirmation}">
                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            Text="Confirm graceful termination (SIGTERM)?"
                                            FontWeight="SemiBold"
                                            TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Confirm" Command="{Binding ConfirmTerminateCommand}"/>
                                            <Button Content="Cancel" Command="{Binding CancelTerminateCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border
                                    Background="#3B1D26"
                                    BorderBrush="#F87171"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    IsVisible="{Binding ShowForceKillConfirmation}">
                                    <StackPanel Spacing="8">
                                        <TextBlock
                                            Text="Confirm force kill (SIGKILL)? Use only if graceful termination fails."
                                            FontWeight="SemiBold"
                                            TextWrapping="Wrap"/>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Content="Confirm" Command="{Binding ConfirmForceKillCommand}"/>
                                            <Button Content="Cancel" Command="{Binding CancelForceKillCommand}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock
                                    Text="{Binding ActionMessage}"
                                    IsVisible="{Binding HasActionMessage}"
                                    TextWrapping="Wrap"
                                    Foreground="{Binding ActionMessageColor}"/>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                    <TextBox
                                        Grid.Column="0"
                                        Text="{Binding PriorityInput, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="Nice value (-20 to 19)"
                                        IsEnabled="{Binding CanChangePriority}"/>

                                    <Button
                                        Grid.Column="1"
                                        Content="Change Priority"
                                        IsEnabled="{Binding CanChangePriority}"
                                        Command="{Binding ChangePriorityCommand}"/>
                                </Grid>

                            </StackPanel>

                        </Border>

                    </StackPanel>

                </StackPanel>
                </ScrollViewer>

            </Border>

        </Grid>

    </Grid>

</UserControl>
