<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:OS_Concepts_Demonstrator.ViewModels.Storage"
    xmlns:models="using:OS_Concepts_Demonstrator.Models"
    x:Class="OS_Concepts_Demonstrator.Views.Storage.StorageManagementView"
    x:DataType="vm:StorageManagementViewModel">

    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#1B1B2B"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <!-- A lighter panel nested inside a card -->
        <Style Selector="Border.inner">
            <Setter Property="Background" Value="#222236"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TextBlock.subtle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Folder names are shown in the accent colour -->
        <Style Selector="TextBlock.folder">
            <Setter Property="Foreground" Value="#38BDF8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="32" Spacing="24">

            <!-- PAGE HEADING -->
            <StackPanel Spacing="6">

                <TextBlock
                    Text="File &amp; Storage Management"
                    FontSize="28"
                    FontWeight="Bold"/>

                <TextBlock
                    Text="Disks, filesystems, mount points and directories (read-only)."
                    FontSize="14"
                    Opacity="0.7"/>

            </StackPanel>

            <!-- ERROR BANNER -->
            <Border
                IsVisible="{Binding HasError}"
                Background="#3B1D26"
                BorderBrush="#F87171"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">

                <TextBlock
                    Text="{Binding ErrorMessage}"
                    Foreground="#F87171"
                    TextWrapping="Wrap"/>

            </Border>

            <!-- STORAGE SUMMARY -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="Storage Overview" Classes="sectionTitle"/>
                    <TextBlock Text="{Binding StorageSummary}" TextWrapping="Wrap"/>
                    <TextBlock
                        Text="A mount point is a folder where a filesystem is attached to the directory tree. It is not a disk: several mount points can share one filesystem, and one disk can hold several partitions."
                        Classes="subtle"/>
                </StackPanel>
            </Border>

            <!-- PHYSICAL DEVICES -->
            <Border Classes="card">

                <StackPanel Spacing="16">

                    <StackPanel Spacing="4">
                        <TextBlock Text="Physical Storage Devices" Classes="sectionTitle"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Disks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:PhysicalDiskModel">

                                <Border Classes="inner" Margin="0,0,0,12">
                                    <StackPanel Spacing="8">

                                        <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Subtitle}" Classes="subtle"/>

                                        <ItemsControl ItemsSource="{Binding Partitions}" Margin="12,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:PartitionModel">
                                                    <StackPanel Spacing="2" Margin="0,4">
                                                        <TextBlock Text="{Binding Text}" FontFamily="monospace"/>
                                                        <TextBlock Text="{Binding MountedText}" Classes="subtle"/>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock
                                            Text="No partitions (the whole disk may hold one filesystem)."
                                            IsVisible="{Binding HasNoPartitions}"
                                            Classes="subtle"/>

                                    </StackPanel>
                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>

            </Border>

            <!-- MOUNTED FILESYSTEMS -->
            <Border Classes="card">

                <StackPanel Spacing="16">

                    <StackPanel Spacing="4">
                        <TextBlock Text="Mounted Filesystems" Classes="sectionTitle"/>
                    </StackPanel>

                    <TextBlock
                        Text="No storage filesystems could be read on this system."
                        IsVisible="{Binding HasNoFilesystems}"
                        Classes="subtle"/>

                    <ItemsControl ItemsSource="{Binding Filesystems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:FilesystemGroupModel">

                                <Border Classes="inner" Margin="0,0,0,12">
                                    <StackPanel Spacing="10">

                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Subtitle}" Classes="subtle"/>
                                            </StackPanel>

                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{Binding UsageLabel}"
                                                FontWeight="SemiBold"
                                                VerticalAlignment="Center"/>
                                        </Grid>

                                        <ProgressBar
                                            Minimum="0"
                                            Maximum="100"
                                            Value="{Binding UsedPercentage}"
                                            Height="10"/>

                                        <TextBlock Text="{Binding Summary}" Classes="subtle"/>

                                        <!-- Physical device > Partition > Filesystem -->
                                        <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
                                            <TextBlock Text="Physical device" Classes="subtle"/>
                                            <TextBlock Grid.Column="1" Text="{Binding PhysicalDeviceText}" TextWrapping="Wrap" FontSize="13"/>

                                            <TextBlock Grid.Row="1" Text="Partition" Classes="subtle"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PartitionText}" TextWrapping="Wrap" FontSize="13"/>

                                            <TextBlock Grid.Row="2" Text="Filesystem" Classes="subtle"/>
                                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FilesystemText}" FontSize="13"/>
                                        </Grid>

                                        <TextBlock
                                            Text="{Binding SharedNote}"
                                            IsVisible="{Binding IsShared}"
                                            Foreground="#38BDF8"
                                            TextWrapping="Wrap"
                                            FontSize="13"/>

                                        <!-- Mount points -->
                                        <TextBlock Text="Mount points" FontWeight="SemiBold"/>

                                        <ItemsControl ItemsSource="{Binding MountPoints}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:MountPointModel">

                                                    <Grid ColumnDefinitions="*,Auto" Margin="0,4">

                                                        <StackPanel Spacing="2">
                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                <TextBlock Text="{Binding Path}" FontFamily="monospace" FontWeight="Bold"/>
                                                                <TextBlock Text="{Binding Description}" Opacity="0.85"/>
                                                            </StackPanel>

                                                            <TextBlock
                                                                Text="{Binding Detail}"
                                                                IsVisible="{Binding HasDetail}"
                                                                Classes="subtle"/>
                                                        </StackPanel>

                                                        <Button
                                                            Grid.Column="1"
                                                            Content="Browse"
                                                            Padding="14,6"
                                                            Click="OnBrowseClick"/>

                                                    </Grid>

                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>
                                </Border>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- VIRTUAL FILESYSTEMS -->
                    <Expander Header="{Binding VirtualFilesystemsTitle}">

                        <StackPanel Spacing="8" Margin="0,8,0,0">

                            <TextBlock
                                Text="These are provided by the kernel or held in RAM. They are not disks and take no space on any drive."
                                Classes="subtle"/>

                            <ItemsControl ItemsSource="{Binding VirtualFilesystems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:VirtualFilesystemModel">

                                        <Grid ColumnDefinitions="260,90,*" ColumnSpacing="10" Margin="0,3">
                                            <TextBlock Text="{Binding MountPoint}" FontFamily="monospace" TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding MountPoint}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding FileSystemType}" Opacity="0.8"/>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap" FontSize="13"/>
                                                <TextBlock Text="{Binding SizeText}" Classes="subtle"/>
                                            </StackPanel>
                                        </Grid>

                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>

                    </Expander>

                </StackPanel>

            </Border>

            <!-- DIRECTORY BROWSER -->
            <Border Classes="card">

                <StackPanel Spacing="16">

                    <StackPanel Spacing="4">
                        <TextBlock Text="Directory Browser" Classes="sectionTitle"/>
                        <TextBlock
                            Text="Double-click a folder to open it. Folder sizes are not shown (it would mean reading the whole tree)."
                            Classes="subtle"/>
                    </StackPanel>

                    <!-- NAVIGATION -->
                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="10">

                        <Button
                            Grid.Column="0"
                            Content="Up"
                            Padding="16,8"
                            Command="{Binding GoUpCommand}"/>

                        <Button
                            Grid.Column="1"
                            Content="Home"
                            Padding="16,8"
                            Command="{Binding GoHomeCommand}"/>

                        <TextBox
                            Grid.Column="2"
                            Text="{Binding CurrentPath}"
                            IsReadOnly="True"
                            VerticalContentAlignment="Center"/>

                    </Grid>

                    <!-- FILE ACTION TOOLBAR (buttons disable themselves when not allowed) -->
                    <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="8">
                        <Button Content="New File" Padding="14,8" Command="{Binding NewFileCommand}"/>
                        <Button Content="New Folder" Padding="14,8" Command="{Binding NewFolderCommand}"/>
                        <Button Content="Rename" Padding="14,8" Command="{Binding RenameCommand}"/>
                        <Button Content="Copy" Padding="14,8" Command="{Binding CopyCommand}"/>
                        <Button Content="Move" Padding="14,8" Command="{Binding MoveCommand}"/>
                        <Button Content="Paste here" Padding="14,8" Command="{Binding PasteCommand}"
                                IsVisible="{Binding HasClipboard}"/>
                        <Button Content="Delete" Padding="14,8" Command="{Binding DeleteCommand}"
                                Foreground="#F87171"/>
                        <Button Content="Properties" Padding="14,8" Command="{Binding PropertiesCommand}"/>
                        <Button Content="Refresh" Padding="14,8" Command="{Binding RefreshCommand}"/>
                    </WrapPanel>

                    <!-- SEARCH BY NAME (recursive from the current folder) -->
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                 PlaceholderText="Search file names in this folder and its sub-folders (e.g. report, *.pdf)">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="Search" Padding="14,8" Command="{Binding SearchCommand}"/>
                        <Button Grid.Column="2" Content="Clear search" Padding="14,8" Command="{Binding ClearSearchCommand}"
                                IsVisible="{Binding IsSearchActive}"/>
                    </Grid>

                    <TextBlock Text="{Binding SearchSummary}" Foreground="#38BDF8" TextWrapping="Wrap" FontSize="13"
                               IsVisible="{Binding SearchSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

                    <!-- CLIPBOARD (item waiting to be pasted) -->
                    <Border Background="#292940" CornerRadius="6" Padding="10" IsVisible="{Binding HasClipboard}">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <TextBlock Text="{Binding ClipboardText}" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelClipboardCommand}"/>
                        </Grid>
                    </Border>

                    <!-- DELETE CONFIRMATION -->
                    <Border Background="#3B1D26" BorderBrush="#F87171" BorderThickness="1" CornerRadius="6" Padding="12"
                            IsVisible="{Binding IsDeleteConfirmationVisible}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding DeleteConfirmationText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Delete" Command="{Binding ConfirmDeleteCommand}" Foreground="#F87171"/>
                                <Button Content="Cancel" Command="{Binding CancelDeleteCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- OVERWRITE CONFIRMATION (Copy/Move onto an existing file) -->
                    <Border Background="#3A2F1B" BorderBrush="#FBBF24" BorderThickness="1" CornerRadius="6" Padding="12"
                            IsVisible="{Binding IsOverwriteConfirmationVisible}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding OverwriteConfirmationText}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Replace" Command="{Binding ConfirmOverwriteCommand}"/>
                                <Button Content="Cancel" Command="{Binding CancelOverwriteCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- WHY THIS FOLDER IS READ-ONLY -->
                    <Border Background="#1E2A3A" BorderBrush="#38BDF8" BorderThickness="1"
                            CornerRadius="6" Padding="10" IsVisible="{Binding IsFolderReadOnly}">
                        <TextBlock TextWrapping="Wrap" FontSize="13">
                            <Run Text="Read-only location. " FontWeight="SemiBold" Foreground="#38BDF8"/>
                            <Run Text="{Binding ReadOnlyReason}"/>
                        </TextBlock>
                    </Border>

                    <!-- NAME PROMPT (New File / New Folder / Rename) -->
                    <Border Background="#292940" BorderBrush="#8B5CF6" BorderThickness="1"
                            CornerRadius="6" Padding="12" IsVisible="{Binding IsNamePromptVisible}">
                        <StackPanel Spacing="8">
                            <TextBlock Text="{Binding NamePromptTitle}" FontWeight="SemiBold"/>
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <TextBox Text="{Binding NamePromptInput, UpdateSourceTrigger=PropertyChanged}"/>
                                <Button Grid.Column="1" Content="{Binding NamePromptConfirmText}"
                                        Command="{Binding ConfirmNamePromptCommand}" IsDefault="True"/>
                                <Button Grid.Column="2" Content="Cancel" Command="{Binding CancelNamePromptCommand}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- RESULT OF THE LAST FILE OPERATION -->
                    <TextBlock Text="{Binding OperationMessage}" IsVisible="{Binding HasOperationMessage}"
                               Foreground="{Binding OperationMessageColor}" TextWrapping="Wrap"/>

                    <TextBlock Text="{Binding DirectorySummary}" Classes="subtle"/>

                    <TextBlock
                        Text="Loading..."
                        IsVisible="{Binding IsLoading}"
                        Foreground="#38BDF8"/>

                    <TextBlock
                        Text="This folder is empty."
                        IsVisible="{Binding IsDirectoryEmpty}"
                        Classes="subtle"/>

                    <!-- TABLE HEADER -->
                    <Border Background="#292940" Padding="12">
                        <Grid ColumnDefinitions="*,70,90,150,110" ColumnSpacing="8">
                            <TextBlock Text="Name" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" Text="Type" FontWeight="Bold"/>
                            <TextBlock Grid.Column="2" Text="Size" FontWeight="Bold" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="Modified" FontWeight="Bold"/>
                            <TextBlock Grid.Column="4" Text="Permissions" FontWeight="Bold"/>
                        </Grid>
                    </Border>

                    <!-- ENTRIES (scrolls on its own) -->
                    <ListBox
                        x:Name="EntriesList"
                        Height="380"
                        ItemsSource="{Binding Entries}"
                        SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                        Background="Transparent"
                        BorderThickness="0"
                        DoubleTapped="OnEntryDoubleTapped">

                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:DirectoryEntryModel">

                                <Border
                                    BorderBrush="#303044"
                                    BorderThickness="0,0,0,1"
                                    Padding="4,10">

                                    <Grid ColumnDefinitions="*,70,90,150,110" ColumnSpacing="8">

                                        <StackPanel>
                                            <TextBlock
                                                Text="{Binding Name}"
                                                Classes.folder="{Binding IsDirectory}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip.Tip="{Binding FullPath}"/>

                                            <!-- Search results only: which sub-folder the item is in -->
                                            <TextBlock
                                                Text="{Binding Location, StringFormat='in {0}'}"
                                                IsVisible="{Binding HasLocation}"
                                                FontSize="11"
                                                Opacity="0.6"
                                                TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding TypeText}" Opacity="0.8"/>

                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{Binding SizeText}"
                                            HorizontalAlignment="Right"/>

                                        <TextBlock Grid.Column="3" Text="{Binding ModifiedText}"/>

                                        <TextBlock
                                            Grid.Column="4"
                                            Text="{Binding Permissions}"
                                            FontFamily="monospace"/>

                                    </Grid>

                                </Border>

                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>

                    <!-- SELECTED ITEM DETAILS -->
                    <Border Background="#292940" CornerRadius="8" Padding="14">
                        <TextBlock
                            Text="{Binding SelectedEntryDetails}"
                            TextWrapping="Wrap"
                            FontSize="13"/>
                    </Border>

                    <!-- PROPERTIES PANEL (metadata read from the inode with statx) -->
                    <Border Classes="inner" IsVisible="{Binding IsPropertiesVisible}">
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding SelectedProperties.Name, FallbackValue=''}"
                                           FontSize="18" FontWeight="Bold" TextWrapping="Wrap"/>
                                <Button Grid.Column="1" Content="Close" Command="{Binding ClosePropertiesCommand}"/>
                            </Grid>

                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                  RowSpacing="6" ColumnSpacing="12">
                                <Grid.Styles>
                                    <Style Selector="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap"/>
                                        <Setter Property="FontSize" Value="13"/>
                                    </Style>
                                    <Style Selector="TextBlock.key">
                                        <Setter Property="Opacity" Value="0.7"/>
                                    </Style>
                                </Grid.Styles>

                                <TextBlock Grid.Row="0" Classes="key" Text="Type"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedProperties.FileType, FallbackValue=''}"/>

                                <TextBlock Grid.Row="1" Classes="key" Text="Size"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedProperties.Size, FallbackValue=''}"/>

                                <TextBlock Grid.Row="2" Classes="key" Text="Size on disk"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedProperties.SizeOnDisk, FallbackValue=''}"/>

                                <TextBlock Grid.Row="3" Classes="key" Text="Created"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedProperties.Created, FallbackValue=''}"/>

                                <TextBlock Grid.Row="4" Classes="key" Text="Last modified"/>
                                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedProperties.Modified, FallbackValue=''}"/>

                                <TextBlock Grid.Row="5" Classes="key" Text="Last accessed"/>
                                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SelectedProperties.Accessed, FallbackValue=''}"/>

                                <TextBlock Grid.Row="6" Classes="key" Text="Inode changed"/>
                                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding SelectedProperties.StatusChanged, FallbackValue=''}"/>

                                <TextBlock Grid.Row="7" Classes="key" Text="Permissions"/>
                                <TextBlock Grid.Row="7" Grid.Column="1" FontFamily="monospace"
                                           Text="{Binding SelectedProperties.Permissions, FallbackValue=''}"/>

                                <TextBlock Grid.Row="8" Classes="key" Text="Meaning"/>
                                <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding SelectedProperties.PermissionsExplained, FallbackValue=''}"/>

                                <TextBlock Grid.Row="9" Classes="key" Text="Owner"/>
                                <TextBlock Grid.Row="9" Grid.Column="1" Text="{Binding SelectedProperties.Owner, FallbackValue=''}"/>

                                <TextBlock Grid.Row="10" Classes="key" Text="Inode / hard links"/>
                                <TextBlock Grid.Row="10" Grid.Column="1">
                                    <Run Text="{Binding SelectedProperties.Inode, FallbackValue=''}"/>
                                    <Run Text="  /  "/>
                                    <Run Text="{Binding SelectedProperties.HardLinks, FallbackValue=''}"/>
                                </TextBlock>

                                <TextBlock Grid.Row="11" Classes="key" Text="Full path"/>
                                <SelectableTextBlock Grid.Row="11" Grid.Column="1" FontSize="13" TextWrapping="Wrap"
                                                     Text="{Binding SelectedProperties.FullPath, FallbackValue=''}"/>

                                <TextBlock Grid.Row="12" Classes="key" Text="Link target"
                                           IsVisible="{Binding SelectedProperties.IsSymbolicLink, FallbackValue=False}"/>
                                <TextBlock Grid.Row="12" Grid.Column="1" Text="{Binding SelectedProperties.LinkTarget, FallbackValue=''}"
                                           IsVisible="{Binding SelectedProperties.IsSymbolicLink, FallbackValue=False}"/>

                                <TextBlock Grid.Row="13" Classes="key" Text="Demonstrator"/>
                                <TextBlock Grid.Row="13" Grid.Column="1" Text="{Binding SelectedProperties.ModifyStatus, FallbackValue=''}"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
