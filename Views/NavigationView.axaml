<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OS_Concepts_Demonstrator.Views.NavigationView">

    <UserControl.Styles>
        <!-- Every sidebar button fills the column so they line up -->
        <Style Selector="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Styles>

    <Border Background="#151521"
            Width="240">

        <StackPanel Margin="20"
                    Spacing="10">

            <TextBlock Text="OS CONCEPTS"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,10,0,25"/>

            <Button Content="Dashboard"
                    HorizontalContentAlignment="Left"
                    Padding="15"
                    Click="OnDashboardClick"/>

            <Button Content="Process Management"
                    HorizontalContentAlignment="Left"
                    Padding="15"
                    Click="OnProcessesClick"/>

            <Button Content="Memory Management"
                    HorizontalContentAlignment="Left"
                    Padding="15"
                     Click="OnMemoryManagementClick"/>

            <Button Content="File &amp; Storage"
                    HorizontalContentAlignment="Left"
                    Padding="15"
                    Click="OnStorageManagementClick"/>

            <Button Content="I/O Management"
                    HorizontalContentAlignment="Left"
                    Padding="15"
                    Click="OnIoManagementClick"/>

            <Button HorizontalContentAlignment="Left"
                    Padding="15"
                    Click="OnIpcManagementClick">
                <TextBlock Text="Interprocess Communication" TextWrapping="Wrap"/>
            </Button>

            <Button Content="OS Services"
                    HorizontalContentAlignment="Left"
                    Padding="15"/>

            <Button Content="Accounting"
                    HorizontalContentAlignment="Left"
                    Padding="15"/>

            <Button Content="Audit"
                    HorizontalContentAlignment="Left"
                    Padding="15"/>

            <Button Content="OS APIs"
                    HorizontalContentAlignment="Left"
                    Padding="15"/>

        </StackPanel>

    </Border>

</UserControl>