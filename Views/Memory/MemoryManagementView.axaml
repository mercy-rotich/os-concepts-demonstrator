
<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:OS_Concepts_Demonstrator.ViewModels.Memory"
    xmlns:controls="using:OS_Concepts_Demonstrator.Controls"
    x:Class="OS_Concepts_Demonstrator.Views.Memory.MemoryManagementView"
    x:DataType="vm:MemoryManagementViewModel">

    <UserControl.Styles>
        <!-- Reusable look for every card on this page -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#1B1B2B"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TextBlock.statLabel">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Opacity" Value="0.7"/>
        </Style>

        <Style Selector="TextBlock.statValue">
            <Setter Property="FontSize" Value="26"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>

        <Style Selector="TextBlock.subtle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="32" Spacing="24">

            <!-- PAGE HEADING -->
            <StackPanel Spacing="6">

                <TextBlock
                    Text="Memory Management"
                    FontSize="28"
                    FontWeight="Bold"/>

                <TextBlock
                    Text="Monitor your system's physical memory usage."
                    FontSize="14"
                    Opacity="0.7"/>

            </StackPanel>

            <!-- ERROR BANNER (only visible when memory cannot be read) -->
            <Border
                IsVisible="{Binding HasError}"
                Background="#3B1D26"
                BorderBrush="#F87171"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">

                <TextBlock
                    Text="{Binding ErrorMessage}"
                    Foreground="#F87171"
                    TextWrapping="Wrap"/>

            </Border>

            <!-- MEMORY OVERVIEW -->
            <Grid ColumnDefinitions="*,*,*"
                  ColumnSpacing="16">

                <!-- TOTAL MEMORY -->
                <Border Grid.Column="0" Classes="card">

                    <StackPanel Spacing="10">
                        <TextBlock Text="Total RAM" Classes="statLabel"/>

                        <TextBlock Text="{Binding TotalMemory}" Classes="statValue"/>
                    </StackPanel>

                </Border>

                <!-- USED MEMORY -->
                <Border Grid.Column="1" Classes="card">

                    <StackPanel Spacing="10">
                        <TextBlock Text="Used RAM" Classes="statLabel"/>

                        <TextBlock Text="{Binding UsedMemory}" Classes="statValue"/>
                    </StackPanel>

                </Border>

                <!-- AVAILABLE MEMORY -->
                <Border Grid.Column="2" Classes="card">

                    <StackPanel Spacing="10">
                        <TextBlock Text="Available RAM" Classes="statLabel"/>

                        <TextBlock Text="{Binding AvailableMemory}" Classes="statValue"/>
                    </StackPanel>

                </Border>

            </Grid>

            <!-- MEMORY USAGE -->
            <Border Classes="card">

                <StackPanel Spacing="20">

                    <Grid ColumnDefinitions="*,Auto">

                        <TextBlock Text="Memory Usage" Classes="sectionTitle"/>

                        <TextBlock
                            Grid.Column="1"
                            Text="{Binding MemoryUsageLabel}"
                            FontSize="16"
                            FontWeight="Bold"/>

                    </Grid>

                    <ProgressBar
                        Minimum="0"
                        Maximum="100"
                        Value="{Binding MemoryUsagePercentage}"
                        Height="16"/>

                    <TextBlock Text="Memory usage is calculated using total physical RAM and Linux's available memory estimate." Classes="subtle"/>

                    <Button
                        Content="Refresh Memory"
                        HorizontalAlignment="Left"
                        Padding="18,10"
                        Click="OnRefreshClick"/>

                </StackPanel>

            </Border>

            <!-- MEMORY USAGE GRAPH -->
            <Border Classes="card">

                <StackPanel Spacing="16">

                    <TextBlock Text="Memory Usage Trend" Classes="sectionTitle"/>

                    <TextBlock Text="Visual representation of RAM usage over time." Classes="subtle"/>

                    <TextBlock
                        Text="{Binding LatestReadingLabel}"
                        FontSize="16"
                        FontWeight="Bold"
                        Foreground="#38BDF8"/>

                    <TextBlock Text="{Binding MonitoringPeriodLabel}" Classes="subtle"/>

                    <controls:MemoryUsageChart
                        Height="250"
                        MinWidth="300"
                        Points="{Binding MemoryChartPoints}"/>

                </StackPanel>

            </Border>

            <!-- MEMORY HISTORY -->
            <Border Classes="card">

                <StackPanel Spacing="16">

                    <TextBlock Text="Memory Usage History" Classes="sectionTitle"/>

                    <TextBlock Text="Recent RAM usage readings collected every five seconds." Classes="subtle"/>

                    <TextBlock
                        Text="No readings yet. The first reading is recorded about five seconds after this page starts."
                        IsVisible="{Binding !HasHistory}"
                        Classes="subtle"/>

                    <ItemsControl ItemsSource="{Binding MemoryHistory}">

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>

                                <Grid ColumnDefinitions="100,*,60"
                                      ColumnSpacing="12">

                                    <TextBlock
                                        Text="{Binding RecordedAt, StringFormat='{}{0:HH:mm:ss}'}"
                                        VerticalAlignment="Center"
                                        FontSize="12"/>

                                    <ProgressBar
                                        Grid.Column="1"
                                        Minimum="0"
                                        Maximum="100"
                                        Value="{Binding UsagePercentage}"
                                        Height="10"
                                        VerticalAlignment="Center"/>

                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding UsagePercentage, StringFormat='{}{0:F1}%'}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        FontSize="12"/>

                                </Grid>

                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                    </ItemsControl>

                </StackPanel>

            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
