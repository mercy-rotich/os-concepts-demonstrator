<UserControl
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:OS_Concepts_Demonstrator.ViewModels.OSApi"
    xmlns:models="using:OS_Concepts_Demonstrator.Models"
    x:Class="OS_Concepts_Demonstrator.Views.OSApi.OsApisView"
    x:DataType="vm:OsApisViewModel">

    <UserControl.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#1B1B2B"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
        </Style>

        <Style Selector="Border.inner">
            <Setter Property="Background" Value="#222236"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="TextBlock.subtle">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Opacity" Value="0.7"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style Selector="Border.layer">
            <Setter Property="Background" Value="#222236"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>

        <Style Selector="Border.explain">
            <Setter Property="Background" Value="#202033"/>
            <Setter Property="BorderBrush" Value="#38BDF8"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,10"/>
        </Style>

        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Opacity" Value="0.65"/>
        </Style>

        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="monospace"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style Selector="TextBlock.accent">
            <Setter Property="Foreground" Value="#38BDF8"/>
        </Style>

        <!-- Coloured status badge: green = available / good, amber = partial / review, grey = not available -->
        <Style Selector="Border.pill">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,3"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Top"/>
            <Setter Property="Background" Value="#2E2E44"/>
        </Style>
        <Style Selector="Border.pill > TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#A7A7B5"/>
        </Style>
        <Style Selector="Border.pill.good">
            <Setter Property="Background" Value="#14391F"/>
        </Style>
        <Style Selector="Border.pill.good > TextBlock">
            <Setter Property="Foreground" Value="#86EFAC"/>
        </Style>
        <Style Selector="Border.pill.partial">
            <Setter Property="Background" Value="#473A12"/>
        </Style>
        <Style Selector="Border.pill.partial > TextBlock">
            <Setter Property="Foreground" Value="#FBBF24"/>
        </Style>
        <Style Selector="Border.pill.none">
            <Setter Property="Background" Value="#3A2A33"/>
        </Style>
        <Style Selector="Border.pill.none > TextBlock">
            <Setter Property="Foreground" Value="#F0A5B5"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <StackPanel Margin="32" Spacing="24">

            <!-- PAGE HEADING -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="6">
                    <TextBlock Text="OS APIs and System Calls" FontSize="28" FontWeight="Bold"/>
                    <TextBlock
                        Text="How a program asks the operating system for services, shown with evidence from this very process. Read-only."
                        FontSize="14"
                        Opacity="0.7"
                        TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding LastUpdated}" Classes="subtle"/>
                </StackPanel>

                <Button Grid.Column="1" Content="Refresh" Padding="18,10" VerticalAlignment="Top" Command="{Binding RefreshCommand}"/>
            </Grid>

            <!-- CONCEPT -->
            <Border Classes="card">
                <StackPanel Spacing="14">

                    <TextBlock Text="What is an operating system API?" Classes="sectionTitle"/>

                    <TextBlock TextWrapping="Wrap" FontSize="14">
                        <Run Text="A program is not allowed to touch hardware or other programs' memory. To open a file, start a process or send data it must ask the kernel, using a system call: a controlled jump from the program (user mode) into the kernel (kernel mode). The set of functions a program may call to request services is the operating system's API. Programs almost never make system calls directly. They go through layers, and each layer hides the details of the one below it."/>
                    </TextBlock>

                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="20">

                        <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                            <Border Classes="layer"><TextBlock Text="Your C# code (this application)" FontWeight="SemiBold"/></Border>
                            <TextBlock Text="v" HorizontalAlignment="Center" Opacity="0.6"/>
                            <Border Classes="layer"><TextBlock Text=".NET class library: File, Process, Socket..." FontWeight="SemiBold"/></Border>
                            <TextBlock Text="v" HorizontalAlignment="Center" Opacity="0.6"/>
                            <Border Classes="layer"><TextBlock Text="libSystem.Native: .NET's shim" FontWeight="SemiBold"/></Border>
                            <TextBlock Text="v" HorizontalAlignment="Center" Opacity="0.6"/>
                            <Border Classes="layer"><TextBlock Text="libc: the C library (POSIX API)" FontWeight="SemiBold"/></Border>
                            <TextBlock Text="v" HorizontalAlignment="Center" Opacity="0.6"/>
                            <Border Classes="layer" BorderBrush="#FBBF24"><TextBlock Text="SYSTEM CALL: the jump into the kernel" FontWeight="Bold" Foreground="#FBBF24"/></Border>
                            <TextBlock Text="v" HorizontalAlignment="Center" Opacity="0.6"/>
                            <Border Classes="layer" BorderBrush="#F87171"><TextBlock Text="Linux kernel" FontWeight="SemiBold"/></Border>
                        </StackPanel>

                        <Rectangle Grid.Column="1" Width="1" Fill="#303044"/>

                        <StackPanel Grid.Column="2" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="Why layers?" FontWeight="Bold"/>
                            <TextBlock Classes="subtle" Text="Portability: the same C# works on any system because only the lower layers know the system-call details."/>
                            <TextBlock Classes="subtle" Text="Convenience: one library call such as File.ReadAllText may need several system calls (open, size, read, close)."/>
                            <TextBlock Classes="subtle" Text="Speed: some calls never enter the kernel at all. Reading the clock is served from a page of kernel code mapped into the process (the vDSO), and the C library caches or computes other answers itself."/>
                            <TextBlock Classes="subtle" Text="Protection: because every request crosses one narrow gate, the kernel can check permissions every time."/>
                        </StackPanel>

                    </Grid>

                </StackPanel>
            </Border>

            <!-- WHAT THIS SYSTEM PROVIDES -->
            <Border Classes="card">
                <StackPanel Spacing="14">

                    <StackPanel Spacing="4">
                        <TextBlock Text="What this system actually provides" Classes="sectionTitle"/>
                        <TextBlock Text="Each source below was checked just now. Green is collected and shown on this page. Red means this system does not provide it, and the reason is given, so nothing here is invented." Classes="subtle"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Sources}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:DataSourceStatusModel">
                                <Border Classes="inner" Margin="0,0,0,10">
                                    <Grid ColumnDefinitions="130,*" ColumnSpacing="14">

                                        <Border
                                            Classes="pill"
                                            Classes.good="{Binding IsAvailable}"
                                            Classes.partial="{Binding IsPartial}"
                                            Classes.none="{Binding IsUnavailable}">
                                            <TextBlock Text="{Binding StatusText}"/>
                                        </Border>

                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Provides}" Classes="label mono"/>
                                            <TextBlock Text="{Binding Detail}" Classes="subtle"/>
                                        </StackPanel>

                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

            <!-- LAYERS IN THIS PROCESS -->
            <Border Classes="card">
                <StackPanel Spacing="14">

                    <StackPanel Spacing="4">
                        <TextBlock Text="The layers inside this very process" Classes="sectionTitle"/>
                        <TextBlock Text="Read from this application's own memory map (/proc/self/maps): the files the loader mapped into it, which are the layers a request passes through." Classes="subtle"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Layers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:ApiLayerModel">
                                <Border Classes="inner" Margin="0,0,0,10">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Path}" Classes="label mono"/>
                                        <TextBlock Text="{Binding Role}" Classes="subtle"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Expander Header="{Binding OtherLibrariesTitle}">
                        <ItemsControl ItemsSource="{Binding OtherLibraries}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Text="{Binding}" Classes="mono" Margin="0,2" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Expander>

                    <TextBlock Text="What this process is allowed to ask the kernel for" FontWeight="SemiBold" Margin="0,10,0,0"/>

                    <ItemsControl ItemsSource="{Binding Restrictions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:DetailRow">
                                <Grid ColumnDefinitions="230,*" ColumnSpacing="14" Margin="0,0,0,8">
                                    <TextBlock Text="{Binding Label}" Classes="label" VerticalAlignment="Top"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontSize="13"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

            <!-- ASK THE C LIBRARY DIRECTLY -->
            <Border Classes="card">
                <StackPanel Spacing="14">

                    <StackPanel Spacing="4">
                        <TextBlock Text="Asking the operating system directly" Classes="sectionTitle"/>
                        <TextBlock Text="This application calls functions of the C library itself (using P/Invoke) and compares the answer with the normal .NET way of getting the same information, or with /proc where .NET has no equivalent. They agree because .NET is built on the same calls." Classes="subtle"/>
                        <TextBlock Text="{Binding CallsNote}" Classes="subtle accent"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding LibcCalls}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:LibcCallModel">
                                <Border Classes="inner" Margin="0,0,0,10">
                                    <StackPanel Spacing="10">

                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Function}" FontFamily="monospace" FontWeight="Bold" FontSize="14"/>
                                                <TextBlock Text="{Binding Asks, StringFormat='Asks for: {0}'}" Classes="subtle"/>
                                            </StackPanel>

                                            <Border
                                                Grid.Column="1"
                                                Classes="pill"
                                                Classes.good="{Binding IsSame}"
                                                Classes.partial="{Binding IsNoEquivalent}"
                                                Classes.none="{Binding IsUnavailable}">
                                                <TextBlock Text="{Binding VerdictText}"/>
                                            </Border>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                                            <StackPanel Spacing="1">
                                                <TextBlock Text="Answer from the C library" Classes="label"/>
                                                <TextBlock Text="{Binding LibcValue}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="13"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Spacing="1">
                                                <TextBlock Text="{Binding DotnetWay}" Classes="label" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding DotnetValue}" TextWrapping="Wrap" FontWeight="SemiBold" FontSize="13"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="{Binding Behind, StringFormat='Behind it: {0}'}" Classes="subtle"/>

                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

            <!-- COUNT SYSTEM CALLS -->
            <Border Classes="card">
                <StackPanel Spacing="14">

                    <StackPanel Spacing="4">
                        <TextBlock Text="Counting this application's own system calls" Classes="sectionTitle"/>
                        <TextBlock Text="The kernel counts how many read system calls each process makes (/proc/self/io). Each button below does a small piece of file reading and shows how many system calls it really took." Classes="subtle"/>
                    </StackPanel>

                    <WrapPanel>
                        <Button Content="Read a small file once" Padding="16,8" Margin="0,0,10,10" Command="{Binding RunReadOnceCommand}"/>
                        <Button Content="Read it 200 times" Padding="16,8" Margin="0,0,10,10" Command="{Binding RunReadManyCommand}"/>
                        <Button Content="5,000 bytes, one byte at a time" Padding="16,8" Margin="0,0,10,10" Command="{Binding RunOneByteAtATimeCommand}"/>
                        <Button Content="Same 5,000 bytes in one call" Padding="16,8" Margin="0,0,10,10" Command="{Binding RunOneCallCommand}"/>
                    </WrapPanel>

                    <Border Classes="explain" IsVisible="{Binding HasNoExperiments}">
                        <TextBlock TextWrapping="Wrap" Classes="subtle" Text="Try the last two buttons one after the other. The data is the same, but the number of trips into the kernel is not. That difference is why programs read in large blocks and why stream classes keep a buffer."/>
                    </Border>

                    <ItemsControl ItemsSource="{Binding Experiments}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:SyscallExperimentModel">
                                <Border Classes="inner" Margin="0,0,0,10">
                                    <StackPanel Spacing="6">

                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Time}" Classes="label mono"/>
                                        </Grid>

                                        <StackPanel Orientation="Horizontal" Spacing="24">
                                            <StackPanel>
                                                <TextBlock Text="System calls" Classes="label"/>
                                                <TextBlock Text="{Binding SyscallsText}" FontSize="18" FontWeight="Bold" Foreground="#FBBF24"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Data" Classes="label"/>
                                                <TextBlock Text="{Binding BytesText}" FontSize="18" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Time" Classes="label"/>
                                                <TextBlock Text="{Binding ElapsedText}" FontSize="18" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Text="{Binding Explanation}" Classes="subtle"/>

                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

            <!-- CATALOG -->
            <Border Classes="card">
                <StackPanel Spacing="14">

                    <StackPanel Spacing="4">
                        <TextBlock Text="Common system calls" Classes="sectionTitle"/>
                        <TextBlock Text="{Binding CatalogNote}" Classes="subtle"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding SyscallGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:SyscallGroupModel">
                                <StackPanel Spacing="8" Margin="0,0,0,16">

                                    <TextBlock Text="{Binding Title}" FontWeight="Bold" Classes="accent" FontSize="15"/>

                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:SyscallInfoModel">
                                                <Border Classes="inner" Padding="14,10" Margin="0,0,0,8">
                                                    <Grid ColumnDefinitions="170,*" ColumnSpacing="14">

                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontFamily="monospace" FontWeight="Bold"/>
                                                            <TextBlock Text="{Binding NumberText, StringFormat='system call {0}'}" Classes="label"/>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="1" Spacing="2">
                                                            <TextBlock Text="{Binding Meaning}" TextWrapping="Wrap" FontSize="13"/>
                                                            <TextBlock Text="{Binding DotnetApi, StringFormat='.NET: {0}'}" Classes="subtle"/>
                                                            <TextBlock Text="{Binding UsedHere, StringFormat='In this app: {0}'}" Classes="subtle"/>
                                                        </StackPanel>

                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Border>

            <!-- GLOSSARY -->
            <Border Classes="card">
                <StackPanel Spacing="10">

                    <TextBlock Text="Terms worth knowing" Classes="sectionTitle"/>

                    <TextBlock TextWrapping="Wrap">
                        <Run Text="API vs system call: " FontWeight="SemiBold"/>
                        <Run Text="an API is any set of functions a program may call. A system call is the specific kind that crosses into the kernel. A library function may make zero, one or several of them."/>
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap">
                        <Run Text="User mode and kernel mode: " FontWeight="SemiBold"/>
                        <Run Text="the processor runs ordinary programs with limited rights. A system call switches it to a privileged mode where the kernel acts for the program, then switches back. That switch has a cost, which is what the one-byte experiment makes visible."/>
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap">
                        <Run Text="File descriptor: " FontWeight="SemiBold"/>
                        <Run Text="a small number the kernel hands out to stand for an open file, pipe or socket. Every file system call after open uses it."/>
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap">
                        <Run Text="vDSO: " FontWeight="SemiBold"/>
                        <Run Text="a few pages of kernel code mapped into every process so that frequently used, harmless operations (such as reading the clock) can run without a real system call."/>
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Capabilities: " FontWeight="SemiBold"/>
                        <Run Text="the kernel splits administrator power into separate privileges. A process with none can still use ordinary system calls but is refused the privileged ones, however it asks."/>
                    </TextBlock>

                    <TextBlock TextWrapping="Wrap">
                        <Run Text="POSIX: " FontWeight="SemiBold"/>
                        <Run Text="a standard that defines the functions Unix-like systems offer (open, read, fork and so on), so programs can move between them. Linux's C library implements it on top of Linux system calls."/>
                    </TextBlock>

                </StackPanel>
            </Border>

        </StackPanel>

    </ScrollViewer>

</UserControl>
